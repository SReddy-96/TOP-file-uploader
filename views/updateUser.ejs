<%- include('partials/header', {title:title}) %>
<main>
  <%- include('partials/aside') %>
  <section>
    <h2 class="section-title">Update User</h2>
    <hr>
    <div class="form-error"><%- include('partials/form-error') %></div>
    <form action="/profile/edit/<%= user.id %>" method="post">
      <label for="username">Username</label>
      <input
        type="text"
        id="username"
        name="username"
        value="<%= user.username %>"
        required
      />
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        value="<%= user.email %>"
        required
      />
      <button type="submit" class="button-primary">Update</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
