<%- include('partials/header', {title:title}) %>
<main>
  <%- include('partials/aside') %>
  <section>
    <h2 class="section-title">Add a New Folder</h2>
    <hr>
    <div class="form-error"><%- include('partials/form-error') %></div>
    <form action="/folder/add" method="post">
      <label for="name">Name</label>
      <input type="name" id="name" name="name" required />
      <label for="folder">Folders</label>
      <select name="folder" id="folder">
        <option value="">None</option>
        <% locals.folders.forEach(folder => { %>
        <option value="<%= folder.id %>"><%= folder.name %></option>
        <% }) %>
      </select>
      <button type="submit" class="button-primary">Add Folder</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
