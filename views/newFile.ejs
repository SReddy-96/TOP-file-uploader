<%- include('partials/header', {title:title}) %>
<main>
  <%- include('partials/aside') %>
  <section>
    <h2 class="section-title">Add a New File</h2>
    <hr />
    <div class="form-error"><%- include('partials/form-error') %></div>
    <form
      action="/file/add"
      method="post"
      enctype="multipart/form-data"
      id="AddFileForm"
    >
      <label for="file">File</label>
      <input type="file" id="file" name="file" required />
      <p><i>File must be under 2MB</i></p>
      <label for="folder">Folder</label>
      <select name="folder" id="folder">
        <option value="">None</option>
        <% locals.folders.forEach(folder => { %>
        <option value="<%= folder.id %>"><%= folder.name %></option>
        <% }) %>
      </select>
      <button type="submit" class="button-primary">Add File</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
