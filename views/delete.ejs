<%- include('partials/header', {title:title}) %>
<main>
  <%- include('partials/aside') %>
  <section>
    <h2 class="section-title">Are you sure you want to delete <%= name %>?</h2>
    <hr />
    <% if (type === "folder") { %>
    <p>All files and folders inside <%= name %> will be permanently deleted?</p>
    <% } %>
    <div class="actionButtons">
      <a class="button-primary" href="/home">Cancel</a>
      <form action="/<%= type %>/delete/<%= id %>" method="post">
        <% if (type === 'file') { %>
        <input type="hidden" name="path" value="<%= path %>" />
        <% } %>
        <button type="submit" class="button-danger">Delete</button>
      </form>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
