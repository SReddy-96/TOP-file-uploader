<%- include('partials/header', {title:title}) %>
<main>
  <%- include('partials/aside') %>
  <section>
    <h2  class="section-title"><%= folder.name %></h2>
    <hr>
    <% if (!folder.parent) { %>
    <p><b>Parent:</b> No Parent</p>
    <% } else { %>
    <p>
      <b>Parent:</b>
      <a href="/folder/<%= folder.parent.id %>"><%= folder.parent.name %> </a>
    </p>
    <% } %>
    <p>
      <b>Created:</b>
      <%= folder.createdAt.toDateString() %>
    </p>
    <p>
      <b>Updated:</b>
      <%= folder.updatedAt.toDateString() %>
    </p>
    <div class="actionButtons">
      <a href="/folder/update/<%= folder.id %>" class="button-primary"
        >Update</a
      >
      <a href="/folder/delete/<%= folder.id %>" class="button-danger">Delete</a>
    </div>
    <h3>Children Folders:</h3>
    <div class="folder-list">
      <% if (folder.children.length===0) { %>
      <p>No Children Folders</p>
      <% } else { %>
      <% folder.children.forEach(child => { %>
      <a href="/folder/<%= child.id %>">
        <%- include('partials/folderCard', {folder: child}) %>
      </a>
      <% }) %>
      <% } %>
    </div>
    <h3>Files:</h3>
    <div class="file-list">
      <% if (folder.files.length===0) { %>
      <p><b>No Files</b></p>
      <% } else { %>
      <% folder.files.forEach(file => { %>
      <a href="/file/<%= file.id %>">
        <%- include('partials/fileCard', {file: file}) %>
      </a>
      <% }) %>
      <% } %>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
